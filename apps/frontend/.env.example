# ============================================================
# DISCOVER SMEs — FRONTEND ENVIRONMENT VARIABLES
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values
# ============================================================

# In local dev, Vite proxies /api → localhost:4000 automatically.
# In production on Render, set this to your backend Render URL:
#   VITE_API_URL=https://discover-festac-api.onrender.com/api/v1
VITE_API_URL=/api/v1

VITE_APP_NAME=Discover SMEs
VITE_APP_VERSION=1.0.0
