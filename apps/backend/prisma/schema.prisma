// ─── TAX MANAGEMENT ─────────────────────────────────────────────

enum TaxType {
  VAT
  INCOME_TAX
  SALES_TAX
  SERVICE_TAX
  WITHHOLDING_TAX
  CUSTOMS_DUTY
  EXCISE_DUTY
  OTHER
}

enum TaxStatus {
  PENDING
  PAID
  OVERDUE
  PARTIALLY_PAID
  WAIVED
  DISPUTED
}

model TaxRecord {
  id          String   @id @default(cuid())
  vendorId    String   @db.Uuid
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  
  type        TaxType
  period      String   // e.g., "2024-Q1", "2024-01"
  description String?
  
  // Tax calculation fields
  baseAmount  Decimal  @db.Decimal(15, 2)
  taxRate     Decimal  @db.Decimal(5, 2) // e.g., 7.5 for 7.5%
  taxAmount   Decimal  @db.Decimal(15, 2)
  
  // VAT specific
  vatInput    Decimal? @db.Decimal(15, 2)
  vatOutput   Decimal? @db.Decimal(15, 2)
  netVat      Decimal? @db.Decimal(15, 2)
  
  // Status and payment
  status      TaxStatus @default(PENDING)
  dueDate     DateTime?
  paidDate    DateTime?
  
  // Additional fields
  reference   String?  // Invoice number, transaction reference
  notes       String?
  metadata    Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  payments    TaxPayment[]
  reports     TaxReport[]
  
  @@index([vendorId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
}

model TaxPayment {
  id          String   @id @default(cuid())
  taxRecordId String
  taxRecord   TaxRecord @relation(fields: [taxRecordId], references: [id], onDelete: Cascade)
  
  amount      Decimal  @db.Decimal(15, 2)
  paymentDate DateTime @default(now())
  paymentMethod String? // e.g., "BANK_TRANSFER", "CASH", "ONLINE"
  reference   String?  // Payment reference/receipt number
  notes       String?
  
  createdAt   DateTime @default(now())
  
  @@index([taxRecordId])
  @@index([paymentDate])
}

model TaxReport {
  id          String   @id @default(cuid())
  taxRecordId String
  taxRecord   TaxRecord @relation(fields: [taxRecordId], references: [id], onDelete: Cascade)
  
  reportType  String   // e.g., "VAT_RETURN", "INCOME_TAX_RETURN"
  period      String
  generatedAt DateTime @default(now())
  
  // Report data
  totalTax    Decimal  @db.Decimal(15, 2)
  totalPaid   Decimal  @db.Decimal(15, 2)
  balance     Decimal  @db.Decimal(15, 2)
  
  // Compliance status
  isCompliant Boolean  @default(true)
  complianceNotes String?
  
  // Report file
  fileUrl     String?
  fileName    String?
  
  createdAt   DateTime @default(now())
  
  @@index([taxRecordId])
  @@index([reportType])
  @@index([period])
}

// ─── CHATBOT SYSTEM ─────────────────────────────────────────────

enum ChatbotRuleType {
  FAQ
  PRICING
  DELIVERY
  HOURS
  PAYMENT
  LOCATION
  CUSTOM
}

enum ChatbotSessionStatus {
  ACTIVE
  HUMAN_TAKEOVER
  CLOSED
}

enum ConversationState {
  WELCOME
  MENU
  FAQ_SEARCH
  PRODUCT_SEARCH
  SERVICE_SEARCH
  WAITING_FOR_OPERATOR
  HUMAN_CHAT
  BOT_RESUMED
  CLOSED
}

model ChatbotSettings {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId            String   @db.Uuid
  chatbotEnabled      Boolean  @default(true)
  greetingMessage     String?  @db.Text
  fallbackMessage     String?  @db.Text
  humanHandoffMessage String? @db.Text
  offlineMessage      String?  @db.Text
  handoffEnabled      Boolean  @default(true)
  businessHoursEnabled Boolean @default(false)
  businessHours       Json?    // Business hours configuration
  fuzzyMatchingEnabled Boolean @default(true)
  fuzzyThreshold      Float    @default(0.3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  vendor              Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rules               ChatbotRule[]
  sessions            ChatbotSession[]

  @@unique([vendorId])
  @@index([vendorId])
  @@map("chatbot_settings")
}

model ChatbotRule {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId          String           @db.Uuid
  ruleType          ChatbotRuleType
  keyword           String
  questionPattern   String?          @db.Text
  response          String           @db.Text
  priority          Int              @default(0)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  vendor            Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "chatbot_rules_vendor_fkey")
  settings          ChatbotSettings  @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "chatbot_rules_settings_fkey")

  @@index([vendorId])
  @@index([ruleType])
  @@index([isActive])
  @@map("chatbot_rules")
}

model ChatbotSession {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId          String                @db.Uuid
  customerPhone     String
  botActive         Boolean               @default(true)
  humanTakeover     Boolean               @default(false)
  sessionStatus     ChatbotSessionStatus  @default(ACTIVE)
  lastMessage       String?               @db.Text
  lastMessageAt     DateTime?
  currentState      ConversationState     @default(WELCOME)
  assignedOperatorId String?              @db.Uuid
  conversationContext Json?              // Store context for multi-turn conversations
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relations
  vendor            Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "chatbot_sessions_vendor_fkey")
  settings          ChatbotSettings       @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "chatbot_sessions_settings_fkey")
  assignedOperator  User?                 @relation("SessionOperator", fields: [assignedOperatorId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([customerPhone])
  @@index([sessionStatus])
  @@index([currentState])
  @@index([assignedOperatorId])
  @@map("chatbot_sessions")
}

// ─────────────────────────────────────────────
// WHATSAPP COST CONTROL SYSTEM (WCCS)
// ─────────────────────────────────────────────

model UsageLog {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId         String      @db.Uuid
  sessionId        String?     @db.Uuid
  messageType      MessageType
  conversationId   String?
  costEstimate     Float
  cached           Boolean     @default(false)
  timestamp        DateTime    @default(now())

  // Relations
  vendor           Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "usage_logs_vendor_fkey")

  @@index([vendorId])
  @@index([timestamp])
  @@index([messageType])
  @@map("usage_logs")
}

model VendorQuota {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId         String      @unique @db.Uuid
  monthlyLimit     Int
  currentUsage     Int         @default(0)
  resetDate        DateTime
  reducedMode      Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  vendor           Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "vendor_quotas_vendor_fkey")

  @@index([vendorId])
  @@map("vendor_quotas")
}

model ResponseCache {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId         String      @db.Uuid
  keyword          String
  response         String      @db.Text
  hitCount         Int         @default(0)
  lastHitAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime    @default(now())

  // Relations
  vendor           Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade, map: "response_cache_vendor_fkey")

  @@unique([vendorId, keyword])
  @@index([vendorId])
  @@index([keyword])
  @@index([expiresAt])
  @@map("response_cache")
}

enum MessageType {
  MARKETING
  UTILITY
  AUTHENTICATION
  SERVICE
  SESSION
}
