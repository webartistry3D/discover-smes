# ============================================================
# DISCOVER FESTAC — BACKEND ENVIRONMENT VARIABLES
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit .env to git
# ============================================================

# ─── APP ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ─── DATABASE ────────────────────────────────────────────────
# Local dev example:
#   postgresql://postgres:yourpassword@localhost:5432/discover_festac
# Render Postgres example (copy from Render dashboard):
#   postgresql://user:pass@host.render.com:5432/discover_festac
DATABASE_URL=postgresql://postgres:password@localhost:5432/discover_festac?schema=public

# ─── JWT ─────────────────────────────────────────────────────
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-different-64-char-random-string
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# ─── OTP ─────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_DELIVERY_METHOD=sms  # Options: sms, email

# ─── EMAIL (for OTP delivery) ───────────────────────────────
# Use a transactional email service (SendGrid, Resend, Mailgun, etc.)
# SendGrid (100 emails/day free): smtp.sendgrid.net, port 587
# Resend (3,000 emails/month free): smtp.resend.com, port 587
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your-api-key-from-email-service
SMTP_FROM=noreply@discoversmes.com

# ─── OPENAI (optional — AI replies work without this in dev) ──
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# ─── WHATSAPP CLOUD API (optional for dev) ───────────────────
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ─── FILE STORAGE ────────────────────────────────────────────
# Use 'local' for dev (saves to ./uploads folder)
# Use 'aws' for production
STORAGE_PROVIDER=local
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=discover-smes-media

# ─── REDIS (optional — app works without it in dev) ──────────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_TTL_SECONDS=3600

# ─── SESSION (for session storage) ─────────────────────────────
SESSION_SECRET=replace-with-64-char-random-string
SESSION_NAME=discover-sms.sid
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# ─── RATE LIMITING ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── CORS ────────────────────────────────────────────────────
# Add your frontend URL(s) — comma separated
CORS_ORIGINS=http://localhost:5173

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=debug
