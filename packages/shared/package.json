{
  "name": "@discover-smes/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && tsup src/index.ts --format esm,cjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "dts-bundle-generator": "^9.5.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
